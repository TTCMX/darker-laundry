# ── Browser (public) ───────────────────────────────────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon

# ── Server only (Vercel functions) — never prefix these with VITE_ ─────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role
# Public URL of the app (tracking links, payment webhooks)
APP_URL=https://your-app.vercel.app
# Protects /api/cron/daily (Vercel sends it automatically)
CRON_SECRET=generate-a-long-random-string

# Optional: platform email sender (each tenant can also set its own in Ajustes)
RESEND_API_KEY=
EMAIL_FROM="Dark Laundry OS <avisos@your-domain.com>"
