{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/|assets/|fonts/).*)", "destination": "/index.html" }],
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 13 * * *" }]
}
